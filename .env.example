# NationStates User Agent (REQUIRED)
# Set this to your main NationStates nation name
NS_USER_AGENT=YourMainNationName

# Logging
RUST_LOG=info

# Bearer token for the query service. Worth setting before the port is reachable
# off loopback; it is a tripwire for a misconfigured bind rather than a security
# boundary, since the data is public and the token sits here in plaintext.
# AKIRAKA_QUERY_TOKEN=

# Shared-quota server, if you run more than one collector. Unset uses the
# built-in pacer, which is correct for a single collector.
# NS_CAS_URL=http://cas.internal:8082

# Akari's log rotation. Akari rotates akari_events.jsonl after THRESHOLD * 1000
# lines and keeps at most MAXFILES segments, gzipping and deleting older ones.
# Akari's own defaults (500 lines, no limit) grow without bound. Raise THRESHOLD
# for larger, fewer segments; lower MAXFILES to keep less history. The raw log is
# what a rebuild re-enriches from, so keep enough to cover your rebuild horizon.
# THRESHOLD has a minimum of 100: a smaller segment can rotate and refill inside
# Akiraka's poll, which would skip events at the start of it.
# Leave either unset to use the value in the baked config.
# AKARI_THRESHOLD=500
# AKARI_MAXFILES=168
